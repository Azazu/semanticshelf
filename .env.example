# Local development configuration — copy to .env. Every value here is
# LOCAL-ONLY; production configuration is out of scope for this file.
COMPOSE_PROJECT_NAME=semanticshelf
BIND_ADDRESS=127.0.0.1
APP_PORT=8000

# PostgreSQL + pgvector
DB_NAME=semanticshelf
DB_USER=semanticshelf
DB_PASSWORD=localdev-only-password
FORWARD_DB_PORT=5433
DATABASE_URL=postgresql+asyncpg://semanticshelf:localdev-only-password@127.0.0.1:5433/semanticshelf

# Models (names only; weights are downloaded to MODEL_CACHE on first use)
EMBEDDER_TEXT_IMAGE=clip-vit-l-14
EMBEDDER_IMAGE_IMAGE=dinov2-large
MODEL_CACHE=.cache/models
MEDIA_ROOT=.data/media
