# Local development configuration — copy to .env. Every value here is
# LOCAL-ONLY; production configuration is out of scope for this file.
COMPOSE_PROJECT_NAME=semanticshelf
BIND_ADDRESS=127.0.0.1
APP_PORT=8000

# PostgreSQL + pgvector
DB_NAME=semanticshelf
DB_USER=semanticshelf
DB_PASSWORD=localdev-only-password
FORWARD_DB_PORT=5433
DATABASE_URL=postgresql+asyncpg://semanticshelf:localdev-only-password@127.0.0.1:5433/semanticshelf

# Models (weights are downloaded to MODEL_CACHE on first use; see docs/how-to/models.md)
ENABLED_MODELS=clip-vit-l14,dinov2-large
MODEL_WARMUP=
MODEL_CACHE=.data/models
CLIP_MODEL_NAME=openai/clip-vit-large-patch14
DINOV2_MODEL_NAME=facebook/dinov2-large
TORCH_NUM_THREADS=0
EMBED_BATCH_SIZE=8
INFERENCE_WORKERS=2
MEDIA_ROOT=.data/media
WORKER_BATCH_SIZE=4
WORKER_POLL_SECONDS=2
INDEXING_RUNNER=inline
HNSW_EF_SEARCH=40
